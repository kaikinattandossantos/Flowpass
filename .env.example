# ============================================================
# FLOWPASS — LOCAL DEVELOPMENT ENVIRONMENT
# ============================================================


# ============================================================
# DATABASE — POSTGRESQL
# ============================================================

DATABASE_URL="postgresql://flowpass:flowpass_password@localhost:55432/flowpass?schema=public"


# ============================================================
# CACHE / QUEUES — REDIS
# ============================================================

REDIS_URL="redis://localhost:6379"


# ============================================================
# AUTHENTICATION — JWT
# ============================================================

JWT_SECRET="flowpass_local_jwt_9fX7mQ2vK8pL4nR6sT1wY5cB3dH0aJ"
JWT_REFRESH_SECRET="flowpass_local_refresh_7kP2xN9mV4qR8tL1sF6wC3yH5bD0zA"


# ============================================================
# QR CODE SECURITY
# ============================================================

QR_HMAC_SECRET="flowpass_local_qr_hmac_8vN3kR7xP1mT9qL5wF2cY6sH4dB0jZ"


# ============================================================
# API
# ============================================================

PORT=3333


# ============================================================
# WEB APPLICATION
# ============================================================

NEXT_PUBLIC_API_URL="http://localhost:3333"


# ============================================================
# MOBILE APPLICATION — EXPO
#
# ATENÇÃO:
# localhost funciona no simulador em alguns cenários.
# Para celular físico, substituir pelo IP local do Mac.
#
# Exemplo:
# EXPO_PUBLIC_API_URL="http://192.168.1.100:3333"
# ============================================================

EXPO_PUBLIC_API_URL="http://localhost:3333"


# ============================================================
# STORAGE — CLOUDFLARE R2 / AWS S3
#
# O storage ainda não está implementado no código atual.
# Substituir quando configurar o provider real.
# ============================================================

R2_BUCKET="flowpass-assets"
R2_ACCESS_KEY="flowpass_local_r2_access_placeholder"
R2_SECRET_KEY="flowpass_local_r2_secret_placeholder"
R2_ENDPOINT="https://placeholder.r2.cloudflarestorage.com"


# ============================================================
# EMAIL — RESEND
#
# Opcional em desenvolvimento. Placeholders são ignorados — a API sobe sem envio real.
# Substituir por chave real re_... para habilitar e-mails.
# ============================================================

RESEND_API_KEY="re_flowpass_local_development_placeholder"


# ============================================================
# WHATSAPP — EVOLUTION API
#
# Valores locais de placeholder.
# Substituir pelas credenciais reais da instância.
# ============================================================

EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="flowpass_local_evolution_api_key_placeholder"
EVOLUTION_INSTANCE="flowpass-local"